{
  "name": "free-llm-api-hub-mcp",
  "version": "0.1.0",
  "description": "MCP server over the free-llm-api-hub dataset: search free-tier LLM API providers, read an entry, and get an OpenAI-client config.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "free-llm-api-hub-mcp": "src/index.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/tools.test.js test/stdio.test.js test/forward-compat.test.js",
    "validate:server-json": "node scripts/validate-server-json.mjs",
    "test:pack": "node --test test/pack.test.js"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pacocartones/free-llm-api-hub.git",
    "directory": "packages/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "mcpName": "io.github.pacocartones/free-llm-api-hub",
  "homepage": "https://freellmapihub.com/",
  "bugs": {
    "url": "https://github.com/pacocartones/free-llm-api-hub/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "free-tier",
    "api",
    "openai-compatible"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
